# =============================================================================
# Hybrid Medallion Lakehouse — Local Environment Variables Example
# Copy this file to .env and fill in real values. Never commit .env.
# =============================================================================

# Snowflake
SNOWFLAKE_ACCOUNT=acme.sa-east-1
SNOWFLAKE_USER=hybrid_lakehouse_dev
SNOWFLAKE_AUTHENTICATOR=externalbrowser
SNOWFLAKE_ROLE=HYBRID_LH_DEV
SNOWFLAKE_WAREHOUSE=HYBRID_LH_DEV_WH
SNOWFLAKE_DATABASE=HYBRID_LH_DEV

# Cloud provider (AWS)
AWS_REGION=sa-east-1
AWS_PROFILE=hybrid-lakehouse-dev

# Object storage
BRONZE_BUCKET=s3://hybrid-lakehouse-dev-bronze
GOLD_BUCKET=s3://hybrid-lakehouse-dev-gold

# GitHub
GITHUB_REPOSITORY=org/hybrid-medallion-lakehouse
